# Demo mode: mock data + local auth. Set false for real Supabase + AI.
VITE_USE_DEMO_MODE=true

# Public Supabase (safe for the browser — RLS still applies)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=AventryX AI

# Telegram (used by Edge Functions only in production)
TELEGRAM_WEBHOOK_SECRET=

# AI provider — NEVER expose this on the frontend. Used by Edge Functions.
AI_PROVIDER=openai
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# OmniRoute AI API (server-side only)
OMNIROUTE_API_KEY=
OMNIROUTE_API_BASE_URL=https://api.omniroute.ai/v1

# Voice (STT / TTS) — server-side only
VOICE_STT_API_KEY=
VOICE_TTS_API_KEY=

# Instagram / Meta (server-side)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Payment providers (server-side, mock until connected)
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
UZUM_MERCHANT_ID=
STRIPE_SECRET_KEY=
