# ---------------------------------------------------------------------------
# SavdoPilot AI - environment template
#
# PUBLIC (VITE_*): inlined into the browser bundle at build time. Never put a
# secret in a VITE_ variable - anyone can read it in devtools.
#
# SERVER-ONLY: read by Vercel Serverless Functions in `api/` at runtime. Set
# them in Vercel -> Project -> Settings -> Environment Variables, never in a
# VITE_ variable, never committed.
# ---------------------------------------------------------------------------

# Demo mode: mock data + local auth. Set false for the real backend.
VITE_USE_DEMO_MODE=true

# --- Public: Supabase (anon key is safe in the browser; RLS applies) --------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Public: Firebase web config (safe client-side) -------------------------
# Guide: FIREBASE_SETUP.md. Until filled, auth uses seeded demo accounts only.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-hash
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Public: app ------------------------------------------------------------
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=SavdoPilot AI
# Same-origin by default. Set only when the API is served from another host.
VITE_API_BASE_URL=

# ===========================================================================
# SERVER-ONLY - never prefix these with VITE_
# ===========================================================================

# --- Database (Supabase service role; bypasses RLS - server only) ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase Admin (verify ID tokens server-side) -------------------------
# Whole service-account JSON on one line, or its base64 encoding.
FIREBASE_SERVICE_ACCOUNT=

# --- CORS: comma-separated list of allowed browser origins -----------------
# localhost / 127.0.0.1 are always allowed for development.
ALLOWED_ORIGINS=https://your-domain.example
APP_URL=https://your-domain.example

# --- AI provider (server-side only) ---------------------------------------
# provider: openai | anthropic | omniroute (anything else is treated as an
# OpenAI-compatible endpoint at AI_API_BASE_URL)
AI_PROVIDER=openai
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Hard cap on AI requests per organization per day (UTC).
AI_DAILY_LIMIT_PER_ORG=200

# OmniRoute AI API (server-side only, used when AI_PROVIDER=omniroute)
OMNIROUTE_API_KEY=
OMNIROUTE_API_BASE_URL=https://api.omniroute.ai/v1

# --- Voice (STT / TTS) - server-side only ---------------------------------
VOICE_STT_API_KEY=
VOICE_TTS_API_KEY=

# --- Telegram / Instagram (server-side) -----------------------------------
TELEGRAM_WEBHOOK_SECRET=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- Payment providers (server-side; empty = reported as "not connected") --
# Callback URLs: https://<your-domain>/api/payments/<provider>/webhook
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_KEY=
UZUM_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
