{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/auth/session", "destination": "/api/auth" },
    { "source": "/api/ai/:action", "destination": "/api/ai?action=:action" },
    { "source": "/api/customers/:id", "destination": "/api/customers?id=:id" },
    { "source": "/api/sales/:id", "destination": "/api/sales?id=:id" },
    { "source": "/api/invoices/:id", "destination": "/api/invoices?id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
